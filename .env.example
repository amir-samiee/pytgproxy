# Telegram API credentials
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# TDLib configuration
LIB_PATH=/path/to/libtdjson.so # (optional, possibly required on windows for the current version)
FILES_DIR=./tdlib_files
ENCRYPTION_KEY=your_encryption_key_here

# Proxy configuration
PROXY_POOLS="https://raw.githubusercontent.com/SoliSpirit/mtproto/master/all_proxies.txt
https://some.other.url/path" 
# as you can see you can add multiple urls separated by newlines just keep
# in mind to use quotes for the scope of the value assigned to the key